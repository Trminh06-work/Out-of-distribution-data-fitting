# Python cache
__pycache__/
*.py[cod]

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# OS files
.DS_Store

# Ignore all raw data
data/raw/

# Ignore all nested directories under data/splitted
data/splitted/*/**

# Keep Data_stat_summ folders inside every dataset
!data/splitted/*/Data_Statistics_Summary/
